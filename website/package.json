{
  "browserslist": {
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ],
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "@beyond10x/docs-system": "git+https://github.com/beyond10x/docs-system.git#8eb302de78feba319fbdd8191270d9fe7b6c1244",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "image-size": "file:vendor/image-size-2.0.3-b10x.1.tgz",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20.0"
  },
  "name": "website",
  "overrides": {
    "image-size": "$image-size",
    "qs": "6.16.0",
    "serialize-javascript": "7.1.1",
    "uuid": "11.1.1"
  },
  "private": true,
  "scripts": {
    "build": "npm run generate-examples && npm run vendor-check && docusaurus build",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "docusaurus": "docusaurus",
    "generate-examples": "cargo run -q --manifest-path ../Cargo.toml -p entity-cli --locked -- generate docs --definition ../examples/refund.yaml --out static/examples/refund --force",
    "serve": "docusaurus serve",
    "start": "npm run generate-examples && docusaurus start",
    "swizzle": "docusaurus swizzle",
    "typecheck": "tsc",
    "vendor-check": "node vendor/image-size/b10x-check.mjs",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  },
  "version": "0.0.0"
}
