["er.eventlog.import-anchor/1",{"authority":{"logical_scope":"entity-runtime","stream_identity":"01a0cab7-1ed7-77a5-8384-ff10c92e7ad6","tenant":"planning"},"completeness":"available_evidence_only","evidence":[],"instance":{"entity":"aep.entity","fields":{"document":{"events":[],"fields":{"$aep":{"archived":false,"metadata":{"created_at":0,"id":"MIG35d52d4ccf209053dbfb78ec10188ff9f262d6312bb1efc6dcaa9292bed56d7a","locator":"ep://planning/store/story/replay-from-events","provenance":{"created_by":"system","updated_by":"system"},"revision":7,"type":"aep.story/v1","updated_at":0}},"body":"# Story: Rehydrate an instance from its events\n\n## Outcome\n\nAn instance can be rebuilt from its event history, so a shell may keep the events as the record and\nthe instance as a cache (R-81, event sourcing).\n\n## Context\n\nR-34 must survive this: replaying `OrderFulfilled` may set the state to `fulfilled` because the\nevent was produced by an operation that was permitted to, and nothing else may. The fold therefore\nneeds the events to carry enough to be applied without re-running rules, or the definition to\ndeclare per event what it does to the state. Decide first. `eventlog` is the natural store.\n\n## Acceptance\n\n`rehydrate(definition, events) -> EntityInstance` with a test that a create + n operations, folded\nfrom their events, equals the instance the operations returned; a test that a hand-written event\nwhose operation the lifecycle does not permit is refused by the fold.\n","relations":[{"derived_from":"epic:kernel"},{"decomposes":"epic:the-shell"},{"depends_on":"story:event-envelope"}],"status":"implemented","summary":"A fold from an event history to an instance, without opening a second write path to lifecycle_state; eventlog is the natural store.","title":"Rehydrate an instance from its events"},"lifecycle_state":"implemented"}},"id":"MIG35d52d4ccf209053dbfb78ec10188ff9f262d6312bb1efc6dcaa9292bed56d7a","lifecycle_state":"recorded","revision":7,"version":1},"order":"per_kind_only","subject":["aep.entity","MIG35d52d4ccf209053dbfb78ec10188ff9f262d6312bb1efc6dcaa9292bed56d7a"]}]