age"},"lifecycle_state":"proposed"},"relations":[{"decides":"epic:kernel"}],"summary":"Conditions are thirteen YAML operators; no CEL, Rhai or Lua behind the rule slots in 0.1.","title":"Rules are a data AST, not an expression language"},"id":"ent-4e01603d4b88a9cd00b068a5e459752a","lifecycle_state":"proposed","revision":2,"version":1},"order":"per_kind_only","subject":["architecture-decision-record","ent-4e01603d4b88a9cd00b068a5e459752a"]}]