 production mutations, original suite associations and implementation identity. `docs/ess/evidence/review/store-executor-adversary.md` records independent refusal-recording and projection-version probes; the final fixtures reject both mutations and the restored run passes. Production files are restored and unchanged.\n\nThe full integrated gate and final suite evidence are retained under `docs/ess/evidence/final/` when complete. Specification adoption remains blocked by AEP's suite/27 admission gap, separately recorded as blocker:er-ess-suite27-evidence. No runtime behavior correction or additional provider scope is claimed.\n","document":{"events":[{"args":{"command":"move-status","decided_on":"{\"recorded\":{\"test_result\":1,\"review_outcome\":1}}","target":"ent-4422067e7f12717bca8a1e5737d89bfe","to":"implemented"},"changed":{"$aep":{"archived":false,"metadata":{"created_at":1790561229679,"id":"ent-4422067e7f12717bca8a1e5737d89bfe","locator":"ep://planning/store/story/er-store-executor-contracts","provenance":{"created_by":"human:timo","updated_by":"human:timo"},"revision":6,"type":"aep.story/v1","updated_at":1790565911305}},"status":"implemented"},"entity":"aep.entity","from_state":"active","id":"ent-4422067e7f12717bca8a1e5737d89bfe","payload":{"actor":"human:timo","at":1790565911305,"causation":"cmd-child-a678f6dfec4354131a1c016fc08f071300d647f51d824b8ae0da6a17851fcad2","correlation":"protocol-artifact-move","event_id":"aep.entity:ent-4422067e7f12717bca8a1e5737d89bfe@6#0~9892411742ecb2fd","executor":null,"recorded_at":"2026-09-28T03:25:11Z"},"revision":6,"to_state":"implemented","type":"aep.status.move/v1","version":1}],"fields":{"$aep":{"archived":false,"metadata":{"created_at":1790561229679,"id":"ent-4422067e7f12717bca8a1e5737d89bfe","locator":"ep://planning/store/story/er-store-executor-contracts","provenance":{"created_by":"human:timo","updated_by":"human:timo"},"revision":6,"type":"aep.story/v1","updated_at":1790565911305}},"body":"# Store and executor exe